{
  "components": {
    "schemas": {
      "CreateShortUrlInput": {
        "properties": {
          "expiry_date": {
            "description": "Optional expiry, format YYYY-MM-DD HH:MM, interpreted in the server's local timezone. Defaults to 30 days after creation.",
            "example": "2026-12-12 21:00",
            "type": "string"
          },
          "original_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "original_url"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ListShortUrlsResponse": {
        "items": {
          "$ref": "#/components/schemas/ShortUrl"
        },
        "type": "array"
      },
      "ShortUrl": {
        "properties": {
          "created_date": {
            "format": "date-time",
            "type": "string"
          },
          "expiry_date": {
            "format": "date-time",
            "type": "string"
          },
          "hash_key": {
            "description": "Auto-generated unique hash key",
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "original_url": {
            "description": "Original URL that was shortened",
            "type": "string"
          },
          "short_url": {
            "description": "Shortened URL that redirects to the original URL",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "URL shortener REST API written in Go. Create a short link for a URL, look it up by hash, or follow the redirect.",
    "title": "ShortUrl",
    "version": "1.0.0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/ping": {
      "get": {
        "operationId": "ping",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "res": {
                      "example": "pong",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Server is up"
          }
        },
        "summary": "Health check",
        "tags": [
          "shorturl"
        ]
      }
    },
    "/redirect/{hashKey}": {
      "get": {
        "operationId": "getRedirect",
        "responses": {
          "302": {
            "content": {
              "text/html": {}
            },
            "description": "Redirect to the original URL",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No short URL with this hash key"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Short URL has expired"
          }
        },
        "summary": "Redirect to the original URL",
        "tags": [
          "shorturl"
        ]
      },
      "parameters": [
        {
          "description": "Hash key of the short URL",
          "in": "path",
          "name": "hashKey",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/short-urls": {
      "get": {
        "operationId": "listShortUrls",
        "parameters": [
          {
            "description": "Page size, 1-100. Defaults to 50; larger values are capped at 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Rows to skip. Defaults to 0.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Shared secret for the create/list endpoints (API_KEY in app config).",
            "in": "header",
            "name": "X-Api-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListShortUrlsResponse"
                }
              }
            },
            "description": "Live short URL entries, paginated (expired links are excluded)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid limit or offset"
          }
        },
        "summary": "List all short URLs",
        "tags": [
          "shorturl"
        ]
      },
      "post": {
        "description": "Creates a short URL for the given original URL. If expiry_date is omitted it defaults to 30 days after creation. Expiry format is YYYY-MM-DD HH:MM. Only http:// and https:// URLs are accepted (a bare host is treated as http); any other scheme is rejected.",
        "operationId": "createShortUrl",
        "parameters": [
          {
            "description": "Shared secret for the create/list endpoints (API_KEY in app config).",
            "in": "header",
            "name": "X-Api-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShortUrlInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortUrl"
                }
              }
            },
            "description": "Short URL created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Invalid request body, invalid URL, invalid expiry format, or expiry date in the past"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Failed to load app config or to store the short URL"
          }
        },
        "summary": "Create a short URL",
        "tags": [
          "shorturl"
        ]
      }
    },
    "/short-urls/{hashKey}": {
      "get": {
        "operationId": "getShortUrlByHashKey",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortUrl"
                }
              }
            },
            "description": "Short URL entry"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No short URL with this hash key"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Short URL has expired"
          }
        },
        "summary": "Get a short URL by hash key",
        "tags": [
          "shorturl"
        ]
      },
      "parameters": [
        {
          "description": "Hash key of the short URL",
          "in": "path",
          "name": "hashKey",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  },
  "servers": [
    {
      "description": "Local development server",
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "description": "Short URL operations",
      "name": "shorturl"
    }
  ]
}
